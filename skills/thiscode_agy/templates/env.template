# Discord state .env — copy to ~/.claude/channels/discord-<your-bot-name>/.env, chmod 600.

# Bot token from Discord Developer Portal → Bot → Reset Token.
# NEVER commit this file to git.
DISCORD_BOT_TOKEN=<your-discord-bot-token>

# Absolute path to agy CLI binary. Default install puts it at ~/.local/bin/agy.
AGY_PATH=/Users/<you>/.local/bin/agy

# AGY permission mode:
#   0 = --sandbox (default; agy prompts before sensitive ops)
#   1 = --dangerously-skip-permissions (no prompts; only on trusted single-user host)
AGY_UNSAFE=0

# Optional: override agy CLI model selection (model name string passed verbatim).
# Default: whatever agy chooses at startup (model names rotate frequently —
# don't rely on a specific version unless you've pinned it).
# GEMINI_MODEL=

# Optional: override Discord gateway mode behavior.
#   USE_DISCORD_GATEWAY=0 forces inbox polling mode (for smoke test without a Discord gateway).
# USE_DISCORD_GATEWAY=1
