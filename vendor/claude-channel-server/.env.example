# Copy this file to ~/.claude/channels/slack/.env (NOT into this repo) and
# fill in real values. Then lock it down:
#
#   mkdir -p ~/.claude/channels/slack
#   cp .env.example ~/.claude/channels/slack/.env
#   chmod 700 ~/.claude/channels/slack
#   chmod 600 ~/.claude/channels/slack/.env
#   $EDITOR ~/.claude/channels/slack/.env
#
# server.ts also enforces/repairs these permissions at startup
# (src/config.ts ensureStateDir, loadEnv) — the manual chmod above is belt
# and suspenders for the first run, not the only line of defense.
#
# Never commit a filled-in .env. Never paste real values into chat with an
# AI agent, a code review, or a bug report — see README.md "Token handling".

# Bot User OAuth Token from your Slack app's "OAuth & Permissions" page.
# Starts with xoxb-.
SLACK_BOT_TOKEN=xoxb-REPLACE-ME

# App-Level Token from your Slack app's "Basic Information" page, with the
# connections:write scope. Starts with xapp-. This is what lets the bridge
# use Socket Mode instead of exposing a public webhook.
SLACK_APP_TOKEN=xapp-REPLACE-ME

# The Slack user ID (not username) of the single person allowed to talk to
# this bridge — messages, @mentions, and permission-approval replies from
# anyone else are silently ignored. Find yours: Slack profile -> "..." ->
# "Copy member ID". Looks like U012ABC3DEF.
ALLOWED_SLACK_USER_ID=U0000REPLACE

# The Slack channel ID this bridge listens in and replies to — the bot must
# be invited to this channel. Messages from any other channel the bot can
# see (e.g. it was invited elsewhere later) are ignored. Find it: open the
# channel in Slack -> "..." -> "Copy channel ID". Looks like C012ABC3DEF.
SLACK_CHANNEL_ID=C0000REPLACE

# ── Optional: bot-to-bot interop ((B) 장치 이식, 2026-08-07) ────────────────
# Leave BOTH unset for the default behavior: every bot-authored message is
# dropped (bots cannot talk to this bridge at all).

# Comma-separated Slack *user* ids (U…, not B…) of OTHER bridge bots allowed
# to talk to this bot. A listed bot still must @-mention this bot and cannot
# use DMs. Unset/empty = bots fully blocked (legacy behavior). There is no
# chain-limit knob — the ported Discord device is mention-pass + allowlist
# only (2026-08-07).
#ALLOWED_SLACK_BOT_USER_IDS=U0000PEER1,U0000PEER2
